# .env.docker.example — قالب متغيرات البيئة لتشغيل SIHATUNA IRAQ ERP عبر
# Docker Compose. انسخي هذا الملف باسم ".env" بنفس هذا المجلد (جذر
# المشروع، بجانب docker-compose.yml)، ثم عبّ القيم الحقيقية:
#
#   cp .env.docker.example .env
#
# ── ملاحظة مهمة جداً ─────────────────────────────────────────────────────
# هذا ملف منفصل تماماً عن backend/.env (المستخدَم بالنشر المحلي العادي عبر
# start.bat) — الاثنان لا يتشاركان أي قيمة تلقائياً، ولهما دور مختلف:
# backend/.env يشير لـ"localhost" لأن كل شيء يعمل مباشرة على نفس الجهاز،
# بينما هذا الملف يُستخدم من docker-compose.yml الذي يفرض أسماء خدمات
# الشبكة الداخلية (postgres، redis) بغض النظر عمّا تكتبينه هنا لـPG_HOST/
# REDIS_URL تحديداً (راجع التعليق بـdocker-compose.yml) — بقية القيم
# (الأسرار، مفاتيح API...) تُقرأ من هنا مباشرة.
#
# لا تلتزم (commit) بملف ".env" الحقيقي أبداً لـ git — هذا القالب فقط
# (.env.docker.example) هو الملف المُتتبَّع.

# ══════════════════════════════════════════════════════════════════════════
# قاعدة البيانات (PostgreSQL) — تُستخدم من قِبل خدمتي postgres وapp معاً
# ══════════════════════════════════════════════════════════════════════════
PG_USER=postgres
# مطلوب — لا قيمة افتراضية عمداً (docker-compose.yml يرفض الإقلاع بدونها،
# راجع شرط ${PG_PASSWORD:?...})
PG_PASSWORD=
PG_DATABASE=sihatuna_iraq
# منفذ PostgreSQL المكشوف على جهازك المضيف (لو احتجت الوصول من pgAdmin
# مثلاً) — لا علاقة له بالاتصال الداخلي بين حاويتي app وpostgres، ذاك
# يعمل دائماً عبر الشبكة الداخلية بغض النظر عن هذه القيمة.
PG_PORT=5432

# ══════════════════════════════════════════════════════════════════════════
# الأمان — مطلوبان، وإلا يرفض الخادم التشغيل (فحص أمان مدمَّج فعلياً بالكود:
# راجع backend/config/jwtConfig.js وbackend/utils/credentialsCrypto.js)
# ══════════════════════════════════════════════════════════════════════════
# توليد قيمة عشوائية قوية:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# توليد قيمة عشوائية قوية (32 بايت بالضبط):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# ══════════════════════════════════════════════════════════════════════════
# الشبكة / CORS
# ══════════════════════════════════════════════════════════════════════════
# ── إصلاح: صار Nginx نقطة الدخول الوحيدة (راجع nginx/nginx.conf وخدمة nginx
# بـdocker-compose.yml) — الفرونت إند والـAPI صارا على نفس الأصل (origin)
# تماماً (نفس المضيف، المنفذ 80 دائماً)، فلم تعد هذه القيم حرجة لعمل تسجيل
# الدخول (الكوكي sameSite:'strict' يعمل بأمان لأي طلب من نفس الأصل أصلاً).
# لا تزال FRONTEND_URL تُستخدَم كخط دفاع CORS احتياطي — عدّلها فقط لو نشرت
# النظام بعنوان/دومين حقيقي غير localhost (مثل http://192.168.1.10 أو
# https://sihatuna-iraq.example.com لاحقاً عند إضافة SSL — بدون منفذ 3000،
# Nginx يستمع على 80 مباشرة).
FRONTEND_URL=http://localhost
# مسار نسبي (لا عنوان/منفذ كامل) — كل طلبات الفرونت إند تصير لنفس الأصل الذي
# فُتحت منه الصفحة، ويوجّهها Nginx بدوره لحاوية app داخلياً (راجع location
# /api/ بـnginx/nginx.conf). تُستخدم وقت بناء صورة الفرونت إند فقط (Create
# React App تُضمّنها بملفات JS النهائية، لا يمكن تغييرها بعد البناء بدون
# إعادة بناء الصورة) — راجع شرح كامل بـDockerfile وdocker-compose.yml
# (build.args). غيّرها لعنوان كامل (مثل http://192.168.1.10/api) فقط لو
# نشرت الفرونت إند والـAPI على أصلين مختلفين تماماً بمستقبل بعيد.
REACT_APP_API_URL=/api

# ══════════════════════════════════════════════════════════════════════════
# الذكاء الاصطناعي (اختياري — التشخيص، التضارب الدوائي، قراءة الفواتير)
# ══════════════════════════════════════════════════════════════════════════
# Gemini مجاني بالكامل لحجم استخدام مستشفى واحد — الأولوية له لو مُعدّ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# بديل مدفوع لو GEMINI_API_KEY غير مُعدّ
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── OCR محلي (PaddleOCR) — خطوة تمهيدية قبل قراءة الفواتير بالذكاء الاصطناعي.
# راجع backend/agents/ocrAgent.js. غير مطلوب إعداده عادةً — القيم
# الافتراضية بالكود تعمل مباشرة داخل حاوية Docker (النموذج مُخبوز مسبقاً
# بالصورة، راجع Dockerfile).
# OCR_LANG=ar
# OCR_TIMEOUT_MS=60000

# ── Ollama (ذكاء اصطناعي محلي/بلا اتصال إنترنت) — بديل ثالث اختياري لـ
# Gemini/Claude، راجع backend/utils/ollamaService.js. يحتاج تثبيت Ollama
# وتنزيل نموذج مسبقاً (`ollama pull <model>`) — لا شيء من هذا مُضمَّن
# بصورة Docker نفسها (خادم Ollama يعمل خارج الحاوية، عادةً على جهازك مباشرة).
# ── مهم جداً لو تشغّل عبر Docker: القيمة الافتراضية بالكود
# (http://localhost:11434) تعمل فقط للتشغيل المحلي المباشر (start.bat) —
# "localhost" داخل حاوية Docker تشير للحاوية نفسها، لا لجهازك المضيف حيث
# يعمل Ollama فعلياً. استخدم دائماً host.docker.internal بدلها هنا:
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_TEXT_MODEL=qwen2.5:0.5b
# OLLAMA_VISION_MODEL=gemma3:4b
# OLLAMA_TIMEOUT_MS=120000

# ══════════════════════════════════════════════════════════════════════════
# البريد الإلكتروني (اختياري — تنبيهات الخادم، انظر backend/utils/alerts.js)
# ══════════════════════════════════════════════════════════════════════════
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ══════════════════════════════════════════════════════════════════════════
# HL7 (نتائج المختبر) وDICOM/Orthanc (الأشعة) — اختياري
# ══════════════════════════════════════════════════════════════════════════
HL7_PORT=2575
ORTHANC_URL=
ORTHANC_USER=
ORTHANC_PASS=

# ══════════════════════════════════════════════════════════════════════════
# بوابات الدفع (اختياري — راجع backend/routes/paymentRoutes.js)
# ══════════════════════════════════════════════════════════════════════════
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET_KEY=
FASTPAY_MERCHANT_ID=
FASTPAY_API_KEY=
QICARD_TERMINAL_ID=
QICARD_API_KEY=
BANK_CARD_MERCHANT_ID=
BANK_CARD_API_KEY=
BANK_CARD_GATEWAY_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ══════════════════════════════════════════════════════════════════════════
# النسخ الاحتياطي الخارجي (اختياري) — مسار داخل الحاوية، لا مسار بجهازك
# المضيف مباشرة. تُركَت فارغة افتراضياً؛ لتفعيلها فعلياً تحتاج أيضاً
# ربط مسار مضيف حقيقي بـdocker-compose.yml (volumes بخدمة app) يطابق نفس
# القيمة هنا — غير مُعدّ افتراضياً بهذا القالب.
EXTERNAL_BACKUP_DIR=
