# .env.docker.example — قالب متغيرات البيئة لتشغيل SIHATUNA IRAQ ERP عبر
# Docker Compose. انسخي هذا الملف باسم ".env" بنفس هذا المجلد (جذر
# المشروع، بجانب docker-compose.yml)، ثم عبّي القيم الحقيقية:
#
#   cp .env.docker.example .env
#
# ── ملاحظة مهمة جداً ─────────────────────────────────────────────────────
# هذا ملف منفصل تماماً عن backend/.env (المستخدَم بالنشر المحلي العادي عبر
# start.bat) — الاثنان لا يتشاركان أي قيمة تلقائياً، ولهما دور مختلف:
# backend/.env يشير لـ"localhost" لأن كل شيء يعمل مباشرة على نفس الجهاز،
# بينما هذا الملف يُستخدم من docker-compose.yml الذي يفرض أسماء خدمات
# الشبكة الداخلية (postgres، redis) بغض النظر عمّا تكتبينه هنا لـPG_HOST/
# REDIS_URL تحديداً (راجعي التعليق بـdocker-compose.yml) — بقية القيم
# (الأسرار، مفاتيح API...) تُقرأ من هنا مباشرة.
#
# لا تلتزمي (commit) بملف ".env" الحقيقي أبداً لـ git — هذا القالب فقط
# (.env.docker.example) هو الملف المُتتبَّع.

# ══════════════════════════════════════════════════════════════════════════
# قاعدة البيانات (PostgreSQL) — تُستخدم من قِبل خدمتي postgres وapp معاً
# ══════════════════════════════════════════════════════════════════════════
PG_USER=postgres
# مطلوب — لا قيمة افتراضية عمداً (docker-compose.yml يرفض الإقلاع بدونها،
# راجعي شرط ${PG_PASSWORD:?...})
PG_PASSWORD=
PG_DATABASE=sihatuna_iraq
# منفذ PostgreSQL المكشوف على جهازك المضيف (لو احتجتِ الوصول من pgAdmin
# مثلاً) — لا علاقة له بالاتصال الداخلي بين حاويتي app وpostgres، ذاك
# يعمل دائماً عبر الشبكة الداخلية بغض النظر عن هذي القيمة.
PG_PORT=5432

# ══════════════════════════════════════════════════════════════════════════
# الأمان — مطلوبان، وإلا يرفض الخادم التشغيل (فحص أمان مدمَّج فعلياً بالكود:
# راجعي backend/config/jwtConfig.js وbackend/utils/credentialsCrypto.js)
# ══════════════════════════════════════════════════════════════════════════
# توليد قيمة عشوائية قوية:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# توليد قيمة عشوائية قوية (32 بايت بالضبط):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# ══════════════════════════════════════════════════════════════════════════
# الشبكة / CORS
# ══════════════════════════════════════════════════════════════════════════
# عنوان الفرونت إند كما يفتحه المستخدم فعلياً بمتصفحه — يُستخدم لضبط CORS
# بالباك إند (يرفض أي طلب من أصل غير هذا). لو النشر يخدم أجهزة أخرى
# بالشبكة، غيّريه لعنوان IP أو دومين السيرفر الفعلي (مثل http://192.168.1.10:3000).
FRONTEND_URL=http://localhost:3000
# نفس الملاحظة — تُستخدم وقت بناء صورة الفرونت إند فقط (Create React App
# تُضمّنها بملفات JS النهائية، لا يمكن تغييرها بعد البناء بدون إعادة بناء
# الصورة). راجعي شرح كامل بـDockerfile وdocker-compose.yml (build.args).
REACT_APP_API_URL=http://localhost:8000/api

# ══════════════════════════════════════════════════════════════════════════
# الذكاء الاصطناعي (اختياري — التشخيص، التضارب الدوائي، قراءة الفواتير)
# ══════════════════════════════════════════════════════════════════════════
# Gemini مجاني بالكامل لحجم استخدام مستشفى واحد — الأولوية له لو مُعدّ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# بديل مدفوع لو GEMINI_API_KEY غير مُعدّ
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ══════════════════════════════════════════════════════════════════════════
# البريد الإلكتروني (اختياري — تنبيهات الخادم، انظر backend/utils/alerts.js)
# ══════════════════════════════════════════════════════════════════════════
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ══════════════════════════════════════════════════════════════════════════
# HL7 (نتائج المختبر) وDICOM/Orthanc (الأشعة) — اختياري
# ══════════════════════════════════════════════════════════════════════════
HL7_PORT=2575
ORTHANC_URL=
ORTHANC_USER=
ORTHANC_PASS=

# ══════════════════════════════════════════════════════════════════════════
# بوابات الدفع (اختياري — راجعي backend/routes/paymentRoutes.js)
# ══════════════════════════════════════════════════════════════════════════
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET_KEY=
FASTPAY_MERCHANT_ID=
FASTPAY_API_KEY=
QICARD_TERMINAL_ID=
QICARD_API_KEY=
BANK_CARD_MERCHANT_ID=
BANK_CARD_API_KEY=
BANK_CARD_GATEWAY_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ══════════════════════════════════════════════════════════════════════════
# النسخ الاحتياطي الخارجي (اختياري) — مسار داخل الحاوية، لا مسار بجهازك
# المضيف مباشرة. تُركَت فارغة افتراضياً؛ لتفعيلها فعلياً تحتاجين أيضاً
# ربط مسار مضيف حقيقي بـdocker-compose.yml (volumes بخدمة app) يطابق نفس
# القيمة هنا — غير مُعدّ افتراضياً بهذا القالب.
EXTERNAL_BACKUP_DIR=
