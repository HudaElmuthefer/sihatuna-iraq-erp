# ============================================================================
# Copy this file to ".env" (same backend/ folder) and fill in real values.
# Never commit the real .env file -- it is already listed in .gitignore.
# ============================================================================
PORT=8000
# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_URL=http://localhost:3000
# Random, unique secret used to sign auth tokens (JWT). Generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=

# ============================================================================
# Payment gateway credentials (all optional -- leave blank for gateways you
# don't use). Get these from each provider's merchant account dashboard.
# ============================================================================
# --- ZainCash ---
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET_KEY=
# --- FastPay ---
FASTPAY_MERCHANT_ID=
FASTPAY_API_KEY=
# --- Qi Card ---
QICARD_TERMINAL_ID=
QICARD_API_KEY=
# --- Other local bank card gateway (optional) ---
BANK_CARD_GATEWAY_URL=
BANK_CARD_MERCHANT_ID=
BANK_CARD_API_KEY=
# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Western Union and cash payments need no API keys -- the accountant logs
# those manually when a payment is received.

# ============================================================================
# PostgreSQL -- primary store for all clinical/admin/financial modules.
# ============================================================================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=sihatuna_iraq

# Encryption key for payment gateway credentials before they're stored in
# PostgreSQL. Required in production -- the server refuses to start under
# NODE_ENV=production without it. Generate your own random value, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
CREDENTIALS_ENCRYPTION_KEY=

# Optional second backup destination (a permanently-connected external
# drive, or a locally-synced cloud folder like Google Drive/OneDrive).
EXTERNAL_BACKUP_DIR=

# ============================================================================
# Email alerts for server monitoring (fully optional)
# ============================================================================
# Without these, monitor.js still works -- it just logs alerts locally
# (backend/data/alerts-log.json) and to the console instead of emailing.
# For a Gmail account, you need an "App Password" (not your normal account
# password) -- Google Account > Security > App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ============================================================================
# AI-powered diagnosis (fully optional)
# ============================================================================
# Without a key here, the AI Diagnosis page falls back to a local symptom
# matcher (no real AI) and says so explicitly in the UI.
#
# -- Recommended: Google Gemini (free tier) --
# https://aistudio.google.com -> "Get API key" -> "Create API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# -- Alternative: Anthropic Claude (paid, often higher quality) --
# Ignored automatically if GEMINI_API_KEY is set above.
# https://console.anthropic.com -> "API Keys"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ============================================================================
# HL7 (lab results) and DICOM/Orthanc (radiology images) integration (both optional)
# ============================================================================
# Port the HL7 receiver listens on for incoming lab results.
HL7_PORT=2575

# Orthanc (separate, free DICOM/PACS server -- https://www.orthanc-server.com/).
# Leave the user/password blank if Orthanc has no login on your closed network.
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=
ORTHANC_PASS=

# Redis (cache, rate limiting, token revocation, the BullMQ job queue).
# Defaults to redis://127.0.0.1:6379 if left unset.
REDIS_URL=redis://127.0.0.1:6379
