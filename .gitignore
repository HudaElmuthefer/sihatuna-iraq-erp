# Do not upload sensitive data or heavy files to GitHub

# Environment variables (contain payment gateway credentials and other secrets)
backend/.env
frontend/.env.local
# The real Docker Compose env file (Phase 3) — copied from
# .env.docker.example, holds real secrets. The leading "/" scopes this to
# the project root only (no effect on backend/.env above, a different path entirely).
/.env

# Dependency folders
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
frontend/build/

# Playwright e2e artifacts (regenerable per run, not source)
e2e/test-results/
e2e/playwright-report/

# Output of scripts/lighthouse-all.js — regenerable, not source
frontend/lighthouse-report-*.json

# Runtime data (generated automatically, not uploaded to GitHub)
backend/backups/
# Manually pulled backups of the Docker database (contain real patient data —
# never upload to GitHub, keep them outside the repository)
db-backups/
backend/data/audit-log.json
backend/data/revoked-tokens.json
backend/data/alerts-log.json
backend/data/monitor-state.json

# System files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
