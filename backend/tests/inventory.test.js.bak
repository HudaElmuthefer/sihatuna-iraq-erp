// backend/tests/inventory.test.js
//
// أول اختبار مخصّص لموديول المخزون — كان بدون أي تغطية اختبارية إطلاقاً رغم
// كونه من أكثر الموديولات استخداماً. يغطي: الحفظ الأساسي، الترقيم من السيرفر،
// البحث بالاسم/الرمز، وفلترة التصنيف (extraFilterFields — ميزة جديدة).
const request = require('supertest');
const { setupTestEnv, cleanupTestEnv, assertPgAvailable } = require('./testUtils');

let dbPath;
let app;
let token;

beforeAll(async () => {
  dbPath = setupTestEnv('inventory');
  app = require('../server');
  const loginRes = await request(app).post('/api/auth/login').send({ username: 'testadmin', password: 'testpass123' });
  token = loginRes.body.token;

  const probe = await request(app).get('/api/inventory').set('Authorization', `Bearer ${token}`);
  assertPgAvailable(probe, 'المخزون');
});

afterAll(async () => {
  cleanupTestEnv(dbPath);
});

describe('POST /api/inventory — حفظ صنف جديد', () => {
  test('رفض صنف بدون رمز (code) أو اسم', async () => {
    const res = await request(app)
      .post('/api/inventory')
      .set('Authorization', `Bearer ${token}`)
      .send({ code: '', name: '' });
    expect(res.status).toBe(400);
  });

  test('حفظ صنف صحيح ينجح ويُعاد بمعرّف', async () => {
    const res = await request(app)
      .post('/api/inventory')
      .set('Authorization', `Bearer ${token}`)
      .send({ code: `INV-TEST-${Date.now()}`, name: 'باراسيتامول اختبار', category: 'medicine', status: 'active' });
    expect(res.status).toBe(201);
    expect(res.body.id).toBeDefined();
  });
});

describe('GET /api/inventory — الترقيم والبحث وفلترة التصنيف', () => {
  test('فلترة التصنيف (?category=) ترجع فقط الأصناف المطابقة', async () => {
    const unique = Date.now();
    await request(app).post('/api/inventory').set('Authorization', `Bearer ${token}`)
      .send({ code: `MED-${unique}`, name: `دواء ${unique}`, category: 'medicine' });
    await request(app).post('/api/inventory').set('Authorization', `Bearer ${token}`)
      .send({ code: `SUP-${unique}`, name: `مستلزم ${unique}`, category: 'supplies' });

    const res = await request(app)
      .get(`/api/inventory?page=1&limit=200&category=medicine&search=${unique}`)
      .set('Authorization', `Bearer ${token}`);

    expect(res.status).toBe(200);
    expect(res.body.data.length).toBe(1);
    expect(res.body.data[0].category).toBe('medicine');
  });

  test('البحث (?search=) يطابق الاسم أو الرمز (code مُضاف بـ searchFields)', async () => {
    const uniqueCode = `SEARCHBYCODE-${Date.now()}`;
    await request(app).post('/api/inventory').set('Authorization', `Bearer ${token}`)
      .send({ code: uniqueCode, name: 'اسم عادي جداً بدون تميّز' });

    const res = await request(app)
      .get(`/api/inventory?page=1&limit=10&search=${uniqueCode}`)
      .set('Authorization', `Bearer ${token}`);

    expect(res.status).toBe(200);
    expect(res.body.data.some(i => i.code === uniqueCode)).toBe(true);
  });
});

describe('استيراد Excel — كشف تكرار بالرمز (code)', () => {
  test('رفع نفس الرمز مرتين عبر الإدخال المباشر (POST) ثم فحص لا يوجد كشف تكرار بمسار POST العادي (متوقّع — الكشف فقط بمسار الاستيراد)', async () => {
    const code = `DUPTEST-${Date.now()}`;
    const first = await request(app).post('/api/inventory').set('Authorization', `Bearer ${token}`).send({ code, name: 'أول' });
    const second = await request(app).post('/api/inventory').set('Authorization', `Bearer ${token}`).send({ code, name: 'ثاني' });
    // POST العادي (من الواجهة) لا يفحص تكراراً — فقط استيراد Excel يسوي هذا الفحص
    expect(first.status).toBe(201);
    expect(second.status).toBe(201);
  });

  test('مسار استيراد Excel نفسه يكتشف صنفاً موجوداً مسبقاً بنفس الرمز (code) ويتجاوزه', async () => {
    const XLSX = require('xlsx');
    const code = `EXCELDUP-${Date.now()}`;

    // أولاً: إدراج مباشر بنفس الرمز (يحاكي صنف مضاف سابقاً بالواجهة العادية)
    await request(app).post('/api/inventory').set('Authorization', `Bearer ${token}`).send({ code, name: 'صنف موجود مسبقاً' });

    // ثانياً: استيراد ملف Excel يحتوي نفس الرمز بالضبط
    const ws = XLSX.utils.aoa_to_sheet([['الرمز', 'الاسم'], [code, 'نفس الصنف من ملف Excel']]);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'المخزون');
    const buffer = XLSX.write(wb, { type: 'buffer', bookType: 'xlsx' });

    const res = await request(app)
      .post('/api/inventory/import-excel')
      .set('Authorization', `Bearer ${token}`)
      .attach('file', buffer, 'test.xlsx');

    expect(res.status).toBe(200);
    expect(res.body.imported).toBe(0);
    expect(res.body.duplicates).toBe(1);
  });
});
