// backend/tests/quality.test.js
//
// أول اختبار لموديولات إدارة الجودة (ISO) — كانت بدون أي جدول قاعدة بيانات
// إطلاقاً قبل هذا الإصلاح (البيانات تُفقَد بمجرد تحديث الصفحة). يتحقق من
// الحفظ الفعلي والاستمرارية عبر PostgreSQL الحقيقي.
const request = require('supertest');
const { setupTestEnv, cleanupTestEnv, assertPgAvailable } = require('./testUtils');

let dbPath;
let app;
let token;

beforeAll(async () => {
  dbPath = setupTestEnv('quality');
  app = require('../server');
  const login = await request(app).post('/api/auth/login').send({ username: 'testadmin', password: 'testpass123' });
  token = login.body.token;

  const probe = await request(app).get('/api/qualityAudits').set('Authorization', `Bearer ${token}`);
  assertPgAvailable(probe, 'إدارة الجودة');
});

afterAll(async () => {
  cleanupTestEnv(dbPath);
});

describe('POST/GET /api/qualityAudits — استمرارية حقيقية (كانت تُفقَد قبل الإصلاح)', () => {
  test('حفظ مراجعة جديدة ثم جلبها يرجع نفس البيانات — يؤكد الاستمرارية الحقيقية', async () => {
    const created = await request(app)
      .post('/api/qualityAudits')
      .set('Authorization', `Bearer ${token}`)
      .send({ title: 'مراجعة اختبار', auditNo: 'AUD-TEST-1', status: 'planned' });
    expect(created.status).toBe(201);
    expect(created.body.id).toBeDefined();

    // نجلب القائمة كاملة من جديد — يحاكي "تحديث الصفحة" اللي كان يفقد البيانات سابقاً
    const list = await request(app).get('/api/qualityAudits').set('Authorization', `Bearer ${token}`);
    expect(list.status).toBe(200);
    expect(list.body.some(a => a.id === created.body.id && a.title === 'مراجعة اختبار')).toBe(true);
  });

  test('رفض مراجعة بدون عنوان', async () => {
    const res = await request(app).post('/api/qualityAudits').set('Authorization', `Bearer ${token}`).send({});
    expect(res.status).toBe(400);
  });
});

describe('POST/PUT/GET /api/qualityNCs — دورة حياة كاملة', () => {
  test('تسجيل عدم مطابقة، تحديث حالتها، والتأكد من بقاء التحديث بعد إعادة الجلب', async () => {
    const created = await request(app)
      .post('/api/qualityNCs')
      .set('Authorization', `Bearer ${token}`)
      .send({ title: 'عدم مطابقة اختبار', ncNo: 'NC-TEST-1', status: 'open', classification: 'minor' });
    expect(created.status).toBe(201);

    const updated = await request(app)
      .put(`/api/qualityNCs/${created.body.id}`)
      .set('Authorization', `Bearer ${token}`)
      .send({ ...created.body, status: 'closed', closeDate: '2026-07-11' });
    expect(updated.status).toBe(200);
    expect(updated.body.status).toBe('closed');

    const refetched = await request(app).get(`/api/qualityNCs/${created.body.id}`).set('Authorization', `Bearer ${token}`);
    expect(refetched.body.status).toBe('closed');
  });
});

describe('POST/PUT /api/qualityKPIs — تحديث القيمة الفعلية يبقى محفوظاً', () => {
  test('إضافة مؤشر أداء وتحديث قيمته الفعلية يبقى بعد إعادة الجلب', async () => {
    const created = await request(app)
      .post('/api/qualityKPIs')
      .set('Authorization', `Bearer ${token}`)
      .send({ name: 'رضا المرضى اختبار', target: 90, actual: 85, unit: '%' });
    expect(created.status).toBe(201);

    const updated = await request(app)
      .put(`/api/qualityKPIs/${created.body.id}`)
      .set('Authorization', `Bearer ${token}`)
      .send({ ...created.body, actual: 92 });
    expect(updated.status).toBe(200);
    expect(updated.body.actual).toBe(92);
  });
});

describe('RBAC — موديولات الجودة تتطلب صلاحية "quality"', () => {
  test('ممرضة بدون صلاحية quality تُرفض بـ403', async () => {
    const nurseLogin = await request(app).post('/api/auth/login').send({ username: 'testnurse', password: 'testpass123' });
    const res = await request(app)
      .post('/api/qualityAudits')
      .set('Authorization', `Bearer ${nurseLogin.body.token}`)
      .send({ title: 'محاولة غير مصرَّحة' });
    expect(res.status).toBe(403);
  });
});
